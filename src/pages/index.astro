---
import Layout from '../layouts/Layout.astro';
import FancyLine from '../components/FancyLine.astro';
---

<Layout title="Scott Walters">
	<main class="flex flex-col items-center justify-center min-h-screen text-gray-300 text-center p-4">
		<img
			src="/images/me.webp"
			alt="Scott Walters"
			class="rounded-full w-32 h-32 mb-6"
		/>
		<h1 class="text-4xl font-bold mb-2">Scott Walters</h1>
		<p class="text-lg mb-6">
			Software Engineer from the Greater Chicago Area
		</p>
		<hr class="w-1/2 md:w-1/3 lg:w-1/4 mb-6 border-gray-700" />

		<div class="space-y-4">
			<FancyLine
				first="See"
				href="https://www.linkedin.com/in/scowalt/"
				iconName="cib:linkedin-in"
				buttonText="LinkedIn"
				last="for my resume."
			/>
			<FancyLine
				first="I code side projects at"
				href="https://github.com/scowalt"
				iconName="cib:github"
				buttonText="Github"
				last="."
			/>
			<FancyLine
				first="and use my"
				href="https://dev.to/scowalt"
				iconName="mdi:pencil"
				buttonText="Dev Blog"
				last="to write about them."
			/>
			<FancyLine
				first="I post music on"
				href="https://www.youtube.com/channel/UC1Y_1-9Q2n0g_iA-sS_0g6Q"
				iconName="cib:youtube"
				buttonText="YouTube"
				last=","
			/>
			<FancyLine
				first="occasional thoughts on"
				href="https://twitter.com/scowalt"
				iconName="cib:twitter"
				buttonText="Twitter"
				last=","
			/>
			<FancyLine
				first="and pictures of food on"
				href="https://www.instagram.com/scowalt/"
				iconName="cib:instagram"
				buttonText="Instagram"
				last="."
			/>
			<FancyLine
				first="It's best to use"
				href="mailto:scott@scowalt.com"
				iconName="mdi:envelope"
				buttonText="Email"
				last="to contact me."
			/>
		</div>
	</main>
</Layout>
