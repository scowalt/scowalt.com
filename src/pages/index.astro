---
import Layout from '../layouts/Layout.astro';
import FancyLine from '../components/FancyLine.astro';

const links = [
  {
    first: 'See',
    href: 'https://www.linkedin.com/in/scowalt/',
    iconName: 'cib:linkedin-in',
    buttonText: 'LinkedIn',
    last: 'for information about my work,',
  },
  {
    first: 'or learn more about',
    href: '/working-with-me',
    buttonText: 'Working With Me',
    last: '.',
  },
  {
    first: 'Check out my',
    href: '/projects',
    buttonText: 'Projects',
    last: ',',
  },
  {
    first: 'or browse the code on',
    href: 'https://github.com/scowalt',
    iconName: 'cib:github',
    buttonText: 'Github',
    last: '.',
  },
  {
    first: 'I post music on',
    href: 'https://www.youtube.com/channel/UCPnjpoktsIYahNqnTAVPagA',
    iconName: 'cib:youtube',
    buttonText: 'YouTube',
    last: '',
  },
  {
    first: 'and occasional thoughts on',
    href: 'https://twitter.com/scowalt',
    iconName: 'cib:twitter',
    buttonText: 'Twitter',
    last: '.',
  },
  {
    first: "It's best to use",
    href: 'mailto:me@scowalt.com',
    iconName: 'mdi:envelope',
    buttonText: 'Email',
    last: 'to contact me.',
  },
];
---

<Layout title="Scott Walters">
  <main class="centered-page">
    <img src="/images/me.webp" alt="Scott Walters" class="portrait" />
    <h1 class="name">Scott Walters</h1>
    <p class="tagline">Software Engineering Leader in New York City</p>
    <hr class="divider" />

    <div class="links">
      {
        links.map((link) => (
          <FancyLine
            first={link.first}
            href={link.href}
            iconName={link.iconName}
            buttonText={link.buttonText}
            last={link.last}
          />
        ))
      }
    </div>
  </main>
</Layout>

<style>
  @layer components {
    .centered-page {
      gap: var(--space-4);
      padding: var(--space-4);
    }

    .portrait {
      width: 16rem;
      height: 16rem;
      border-radius: var(--radius-full);
    }

    .name {
      font-size: var(--text-4xl);
      line-height: var(--leading-4xl);
      font-weight: 700;
    }

    .tagline {
      font-size: var(--text-lg);
      line-height: var(--leading-lg);
    }

    .divider {
      width: 50%;
      border-color: var(--color-gray-300);
    }

    .links > :global(:not(:last-child)) {
      margin-block-end: var(--space-4);
    }

    @media (width >= 48rem) {
      .divider {
        width: 33.3333%;
      }
    }

    @media (width >= 64rem) {
      .divider {
        width: 25%;
      }
    }
  }
</style>
