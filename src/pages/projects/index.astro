---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = await getCollection('projects');
projects.sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Projects - Scott Walters"
  description="A selection of projects I've built: why I built them, how, and what I'm most proud of."
>
  <main
    class="mx-auto min-h-screen w-full max-w-[70ch] px-6 py-16 text-gray-300 lg:py-24"
  >
    <a href="/" class="mb-8 inline-block text-sm hover:underline">
      &larr; Home
    </a>
    <h1 class="mb-8 text-4xl font-bold text-white">Projects</h1>
    <div class="space-y-2">
      {
        projects.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            screenshot={project.data.screenshot}
            slug={project.id}
          />
        ))
      }
    </div>
  </main>
</Layout>
