---
import { Icon } from 'astro-icon/components';

interface Props {
  first?: string;
  last?: string;
  buttonText: string;
  href: string;
  iconName?: string | undefined;
}

const { first, last, buttonText, href, iconName } = Astro.props;
const isExternal = href.startsWith('http');
---

<div class="fancy-line">
  <span>{first}</span>
  <a
    href={href}
    target={isExternal ? '_blank' : undefined}
    rel={isExternal ? 'noopener noreferrer' : undefined}
    class="link"
  >
    {iconName && <Icon name={iconName} class="icon" />}{buttonText}
  </a>
  <span>{last}</span>
</div>

<style>
  @layer components {
    .fancy-line {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: var(--space-1) var(--space-2);
    }

    .link {
      white-space: nowrap;
    }

    @media (hover: hover) {
      .link:hover {
        text-decoration-line: underline;
      }
    }

    .icon {
      display: inline-block;
      margin-right: var(--space-1);
      width: 1em;
      height: 1em;
      flex-shrink: 0;
      vertical-align: -0.125em;
    }
  }
</style>
