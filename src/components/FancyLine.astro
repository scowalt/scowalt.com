---
import { Icon } from 'astro-icon/components';

interface Props {
  first?: string;
  last?: string;
  buttonText: string;
  href: string;
  iconName?: string | undefined;
}

const { first, last, buttonText, href, iconName } = Astro.props;
const isExternal = href.startsWith('http');
---

<div class="fancy-line">
  <span>{first}</span>
  <a
    href={href}
    target={isExternal ? '_blank' : undefined}
    rel={isExternal ? 'noopener noreferrer' : undefined}
    class="inline-flex items-center whitespace-nowrap hover:underline"
  >
    {iconName && <Icon name={iconName} class="mr-1.5 h-4 w-4 shrink-0" />}{
      buttonText
    }
  </a>
  <span>{last}</span>
</div>

<style>
  .fancy-line {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.25rem 0.5rem;
  }
</style>
