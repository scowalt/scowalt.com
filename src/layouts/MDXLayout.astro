---
import Layout from './Layout.astro';

interface Props {
  frontmatter: {
    title: string;
  };
}

const { frontmatter } = Astro.props;
---

<Layout title={frontmatter.title}>
  <main class="page-column">
    <a href="/" class="back-link"> &larr; Home </a>
    <div class="prose">
      <slot />
    </div>
  </main>
</Layout>
