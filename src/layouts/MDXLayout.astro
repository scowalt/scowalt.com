---
import Layout from './Layout.astro';

interface Props {
  frontmatter: {
    title: string;
  };
}

const { frontmatter } = Astro.props;
---

<Layout title={frontmatter.title}>
  <main
    class="mx-auto min-h-screen w-full max-w-[70ch] px-6 py-16 text-gray-300 lg:py-24"
  >
    <div class="prose prose-invert w-full">
      <slot />
    </div>
  </main>
</Layout>
