---
import Layout from './Layout.astro';

interface Props {
  frontmatter: {
    title: string;
  };
}

const { frontmatter } = Astro.props;
---

<Layout title={frontmatter.title}>
  <main
    class="flex min-h-screen flex-col items-center justify-center gap-4 px-4 py-24 text-center text-gray-300 lg:py-36"
  >
    <div class="prose prose-invert w-full max-w-3xl text-left">
      <slot />
    </div>
  </main>
</Layout>
