---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  screenshot: string;
  techStack: string[];
  url?: string | undefined;
  repo?: string | undefined;
}

const { title, description, screenshot, techStack, url, repo } = Astro.props;
---

<Layout title={`${title} - Scott Walters`} description={description}>
  <main class="page-column">
    <a href="/projects" class="back-link"> &larr; Back to Projects </a>

    <img
      src={`/images/projects/${screenshot}`}
      alt={`Screenshot of ${title}`}
      class="screenshot"
    />

    <h1 class="page-title">
      {
        url ? (
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            class="title-link"
          >
            {title}
          </a>
        ) : (
          title
        )
      }
    </h1>

    <p class="tech-stack">
      {techStack.join(' · ')}
    </p>

    {
      repo && (
        <div class="project-links">
          <a href={repo} target="_blank" rel="noopener noreferrer">
            Source Code &rarr;
          </a>
        </div>
      )
    }

    <div class="prose">
      <slot />
    </div>
  </main>
</Layout>

<style>
  @layer components {
    .screenshot {
      margin-bottom: var(--space-8);
      width: 100%;
      border-radius: var(--radius-lg);
      object-fit: cover;
    }

    .page-title {
      margin-bottom: var(--space-2);
    }

    .title-link {
      color: var(--color-white);
    }

    .tech-stack {
      margin-bottom: var(--space-4);
      font-size: var(--text-xs);
      line-height: var(--leading-xs);
      color: var(--color-gray-500);
    }

    .project-links {
      display: flex;
      gap: var(--space-4);
      margin-bottom: var(--space-8);
      font-size: var(--text-sm);
      line-height: var(--leading-sm);
    }

    @media (hover: hover) {
      .title-link:hover {
        color: rgb(var(--accent-light));
      }

      .project-links a:hover {
        text-decoration-line: underline;
      }
    }
  }
</style>
