{
  "name": "scowalt.com",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "bun x astro dev",
    "start": "bun x astro dev",
    "build": "bun x astro build",
    "preview": "bun x astro preview",
    "astro": "bun x astro",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "bunx astro check",
    "audit": "bun audit",
    "prepare": "bunx simple-git-hooks"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@eslint/js": "9.39.2",
    "@tailwindcss/typography": "0.5.19",
    "cspell": "9.6.2",
    "@typescript-eslint/eslint-plugin": "8.54.0",
    "@typescript-eslint/parser": "8.54.0",
    "eslint": "9.39.2",
    "eslint-plugin-astro": "1.5.0",
    "globals": "16.5.0",
    "lint-staged": "16.2.7",
    "prettier": "3.8.1",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0",
    "remark-cli": "12.0.1",
    "remark-mdx": "3.1.1",
    "remark-preset-lint-consistent": "6.0.1",
    "remark-preset-lint-recommended": "7.0.1",
    "simple-git-hooks": "2.13.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged",
    "pre-push": "bun run typecheck"
  },
  "lint-staged": {
    "*.{js,ts,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.mdx": [
      "cspell lint --no-progress --no-summary",
      "remark --frail --no-stdout",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.css": [
      "prettier --write"
    ],
    "terraform/*.tf": [
      "terraform fmt"
    ]
  },
  "dependencies": {
    "@astrojs/cloudflare": "12.6.12",
    "@astrojs/mdx": "4.3.13",
    "@iconify-json/cib": "1.2.3",
    "@iconify-json/mdi": "1.2.3",
    "@tailwindcss/vite": "4.1.18",
    "astro": "5.16.15",
    "astro-icon": "1.1.5",
    "tailwindcss": "4.1.18"
  },
  "overrides": {
    "@eslint/plugin-kit": "0.5.1",
    "axios": "1.13.4",
    "form-data": "4.0.5",
    "tar": "7.5.7",
    "vite": "6.4.1"
  }
}
