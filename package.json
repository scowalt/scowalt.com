{
  "name": "scowalt.com",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "bun x astro dev",
    "start": "bun x astro dev",
    "build": "bun x astro build",
    "preview": "bun x astro preview",
    "astro": "bun x astro",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "bunx astro check",
    "audit": "bun audit",
    "prepare": "bunx simple-git-hooks"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@eslint/js": "9.37.0",
    "@typescript-eslint/eslint-plugin": "8.37.0",
    "@typescript-eslint/parser": "8.37.0",
    "eslint": "9.37.0",
    "eslint-plugin-astro": "1.3.1",
    "globals": "16.4.0",
    "lint-staged": "16.2.4",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.7.0",
    "simple-git-hooks": "2.13.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.37.0"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged",
    "pre-push": "bun run typecheck"
  },
  "lint-staged": {
    "*.{js,ts,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "terraform/*.tf": [
      "terraform fmt"
    ]
  },
  "dependencies": {
    "@astrojs/cloudflare": "12.6.10",
    "@iconify-json/cib": "1.2.3",
    "@iconify-json/mdi": "1.2.3",
    "@tailwindcss/vite": "4.1.14",
    "astro": "5.14.5",
    "astro-icon": "1.1.5",
    "tailwindcss": "4.1.14"
  },
  "overrides": {
    "@eslint/plugin-kit": "0.4.0",
    "axios": "1.12.2",
    "form-data": "4.0.4"
  }
}
